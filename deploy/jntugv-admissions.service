[Unit]
Description=JNTUGV Admissions Portal
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jntugv-admissions/htdocs/admissions.jntugv.edu.in/jntugv_admmissions
EnvironmentFile=/etc/jntugv-admissions.env
ExecStart=/usr/bin/node /home/jntugv-admissions/htdocs/admissions.jntugv.edu.in/jntugv_admmissions/server/index.js
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
